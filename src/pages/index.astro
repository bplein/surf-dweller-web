		<rect x="4" y="4" width="472" height="152" rx="16" fill="#F5F5F5" stroke="#3B759C" stroke-width="4"/>
		<text x="240" y="98" text-anchor="middle" font-family="Comfortaa, sans-serif" font-size="52" font-weight="700" fill="#3B759C">Surf Dweller</text>
	</svg>
	<h1>Welcome</h1>
	<p>Welcome to the official site.</p>
	<a href="#" class="portal-link">Home Owners Portal</a>
</Layout>
