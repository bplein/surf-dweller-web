---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Surf Dweller">
	<div class="hero-container">
		<img src="/images/logo.jpg" alt="Surf Dweller Logo" class="logo" />
		<h1 class="display-title">Welcome</h1>
		<p class="sub-text">Welcome to the official site.</p>
		<a href="https://home.rdfassociates.com/public" class="button-primary">Home Owners Portal</a>
	</div>
</Layout>

<style>
	.hero-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.logo {
		width: clamp(250px, 50vw, 400px);
		height: auto;
		margin-bottom: 2rem;
		filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
	}

	.display-title {
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		margin-bottom: 1rem;
	}

	.sub-text {
		font-size: clamp(1.1rem, 3vw, 1.5rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.5;
		margin-bottom: 2rem;
		opacity: 0.9;
	}

	.button-primary {
		display: inline-block;
		padding: 14px 32px;
		background: #0071e3;
		color: white;
		text-decoration: none;
		border-radius: 12px;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.2s ease, background 0.2s ease;
		box-shadow: 0 4px 15px rgba(0,0,0,0.2);
	}

	.button-primary:hover {
		background: #0077ed;
		transform: scale(1.03);
	}

	.button-primary:active {
		transform: scale(0.97);
	}
</style>